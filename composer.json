{
  "name": "arthurperton/popular",
  "description": "Pageview tracker for Statamic 6+",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "ArthurPerton\\Popular\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "statamic": {
      "name": "Popular",
      "description": "Pageview tracker for Statamic 6+"
    },
    "laravel": {
      "providers": [
        "ArthurPerton\\Popular\\ServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.3",
    "statamic/cms": "^6.0"
  },
  "require-dev": {
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^11.0",
    "orchestra/testbench": "^10.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pixelfear/composer-dist-plugin": true
    }
  }
}